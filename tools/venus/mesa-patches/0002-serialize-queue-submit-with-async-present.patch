diff -ru a/src/virtio/vulkan/vn_wsi.c b/src/virtio/vulkan/vn_wsi.c
--- a/src/virtio/vulkan/vn_wsi.c	2026-10-13 19:28:15.017529848 -0400
+++ b/src/virtio/vulkan/vn_wsi.c	2026-10-13 19:28:15.019754225 -0400
@@ -494,6 +494,32 @@
    simple_mtx_unlock(&queue->async_present.queue_mutex);
 }
 
+/* Holds the queue against the async present thread for a whole submission.
+ * vn_wsi_flush only waited for the present in flight: the thread could take
+ * the queue for the next present right after and submit concurrently, and
+ * both submissions built their batches in the queue's one cached storage
+ * (DXVK games crashed in vtest_vcmd_submit_cmd2 on a sync pointer of 1).
+ */
+bool
+vn_wsi_queue_lock(VkQueue queue_handle)
+{
+   struct vn_queue *queue = vn_queue_from_handle(queue_handle);
+
+   if (!queue->async_present.initialized ||
+       queue->async_present.tid == vn_gettid())
+      return false;
+
+   simple_mtx_lock(&queue->async_present.queue_mutex);
+   return true;
+}
+
+void
+vn_wsi_queue_unlock(VkQueue queue_handle)
+{
+   struct vn_queue *queue = vn_queue_from_handle(queue_handle);
+   simple_mtx_unlock(&queue->async_present.queue_mutex);
+}

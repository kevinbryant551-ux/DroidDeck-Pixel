@@ -81,6 +81,14 @@
 void
 vkr_library_unload(struct vulkan_library *lib)
 {
+#if defined(__TERMUX__)
+   /* Android's Vulkan stack registers thread-exit destructors (pthread keys) that outlive the
+    * context: unloaded, a worker thread exiting later jumped into unmapped code (SIGSEGV in
+    * pthread_key_clean_all, or "pthread_mutex_lock called on a destroyed mutex"). The loader
+    * stays for the life of the process, as it would in any Android app. */
+   (void)lib;
+   return;
+#endif

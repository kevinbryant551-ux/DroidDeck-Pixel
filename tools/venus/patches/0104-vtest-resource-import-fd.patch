 #define VCMD_RES_CREATE_SIZE 10
 #define VCMD_RES_CREATE_RES_HANDLE 0 /* must be 0 since protocol version 3 */
 #define VCMD_RES_CREATE_TARGET 1
@@ -346,6 +351,11 @@
 #define VCMD_DRM_SYNC_TRANSFER_FLAGS 6
 
 #define VCMD_RESOURCE_EXPORT_FD_SIZE 1
+
+/* VCMD_RESOURCE_IMPORT_FD: the dma-buf follows as SCM_RIGHTS; the reply carries the res_id */
+#define VCMD_RESOURCE_IMPORT_FD_SIZE 2
+#define VCMD_RESOURCE_IMPORT_FD_SIZE_LO 0
+#define VCMD_RESOURCE_IMPORT_FD_SIZE_HI 1

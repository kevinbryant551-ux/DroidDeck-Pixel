+      image_log[i].flags = image_info->flags;
+      image_log[i].external = handle_info != NULL;
+      image_log[i].modifier = modifier;
+      pthread_mutex_unlock(&image_log_lock);
+   }
+#else
    vkr_image_create_and_add(dispatch->data, args);
+#endif
 }
 

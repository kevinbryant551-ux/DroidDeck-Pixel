+#if defined(__TERMUX__)
+/* Unlinks the struct of this type from a chain for the driver's call; returns its predecessor so
+ * vkr_relink puts it back where it was. The reply is decoded by walking the guest's chain in its
+ * own order, so a struct put back anywhere else breaks the decode (a NULL dereference in Venus). */
+static VkBaseOutStructure *
+vkr_unlink(void *chain, VkStructureType type, VkBaseOutStructure **out)
+{
+   for (VkBaseOutStructure *prev = chain; prev->pNext; prev = prev->pNext) {
+      if (prev->pNext->sType == type) {
+         *out = prev->pNext;
+         prev->pNext = prev->pNext->pNext;
+         return prev;
+      }
+   }
+   *out = NULL;
+   return NULL;
+}
+
+static void
+vkr_relink(VkBaseOutStructure *prev, VkBaseOutStructure *s)
+{
+   if (prev && s) {
+      s->pNext = prev->pNext;
+      prev->pNext = s;
+   }
+}
+#endif

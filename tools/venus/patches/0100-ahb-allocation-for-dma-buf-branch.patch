virglrenderer 1.3.0's dma-buf branch of vkAllocateMemory calls vkr_gbm_get_fd_info_from_allocation_info,
which 0011 replaces with the AHardwareBuffer allocator under another name. Point the old name at it.
--- a/src/venus/vkr_device_memory.c
+++ b/src/venus/vkr_device_memory.c
@@ -343,6 +343,8 @@
    vkr_gbm_bo_destroy(bo);
    return VK_ERROR_OUT_OF_DEVICE_MEMORY;
 }
+/* 1.3.0's dma-buf branch calls the gbm name; on Android the AHardwareBuffer path is it. */
+#define vkr_gbm_get_fd_info_from_allocation_info vkr_get_fd_info_from_allocation_info
 #else
 static inline VkResult
 vkr_gbm_get_fd_info_from_allocation_info(UNUSED struct vkr_physical_device *physical_dev,
